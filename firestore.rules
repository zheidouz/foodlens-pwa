rules_version = '2';

// Per-user data isolation
service cloud.firestore {
  match /databases/{database}/documents {

    // User's own scan history
    match /users/{userId}/scans/{scanId} {
      // Must be authenticated as this user AND provide required fields
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null 
        && request.auth.uid == userId 
        && request.resource.data.keys().hasAll(['productName', 'scannedAt', 'healthScore']);
    }

    // User profile data — validate shape on write
    match /users/{userId}/profile/{profileId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.size() < 10000
        && request.resource.data.keys().hasAny(['name', 'preferences', 'allergies', 'goals', 'createdAt']);
    }

    // Deny everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
